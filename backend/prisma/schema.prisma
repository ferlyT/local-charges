generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "sqlserver"
}

model tbUsers {
  fdId        Int       @id @default(autoincrement())
  fdNama      String    @db.VarChar(100)
  fdUsername  String    @unique @db.VarChar(50)
  fdPassword  String    @db.VarChar(255)
  fdAktif     Boolean   @default(true)
  fdCreatedAt DateTime  @default(now())
  fdAvatar    String?   @db.VarChar(500)

  fdRoleId    Int?
  role        tbRoles?  @relation(fields: [fdRoleId], references: [fdId], onUpdate: NoAction)

  localCharges         tbLocalCharges[]
  localChargesLampiran tbLocalChargesLampiran[]
  inspectionReports    tbInspectionReport[]
  inspectionReportLampiran tbInspectionReportLampiran[]
  priceListUploads     tbPriceListUpload[]
}

model tbRoles {
  fdId        Int       @id @default(autoincrement())
  fdNama      String    @unique @db.VarChar(50)
  fdDeskripsi String?   @db.VarChar(255)
  fdCreatedAt DateTime  @default(now())

  users       tbUsers[]
  permissions tbRolePermissions[]
}

model tbRolePermissions {
  fdId         Int       @id @default(autoincrement())
  fdRoleId     Int
  role         tbRoles   @relation(fields: [fdRoleId], references: [fdId], onDelete: Cascade)
  fdPermission String    @db.VarChar(100)

  @@unique([fdRoleId, fdPermission])
}

model tbLocalCharges {
  fdId           Int       @id @default(autoincrement())
  fdNomorForm    String    @unique @db.VarChar(30)
  fdQty          Decimal?  @db.Decimal(10, 3)
  fdSatuanQty    String?   @default("M3") @db.VarChar(20)
  fdStatus       Int       @default(1) @db.TinyInt
  fdDibuat       String?   @db.VarChar(100)
  fdTglDibuat    DateTime?
  fdDirequest    String?   @db.VarChar(100)
  fdTglDirequest DateTime?
  fdBilling      String?   @db.VarChar(100)
  fdTglBilling   DateTime?
  fdAR           String?   @db.VarChar(100)
  fdTglAR        DateTime?
  fdDiketahui    String?   @db.VarChar(100)
  fdTglDiketahui DateTime?
  
  fdCreatedBy    Int
  user           tbUsers   @relation(fields: [fdCreatedBy], references: [fdId], onUpdate: NoAction)
  
  fdCreatedAt    DateTime  @default(now())
  fdUpdatedAt    DateTime  @default(now())
  fdDeletedAt    DateTime?

  details        tbLocalChargesDetail[]
  lampiran       tbLocalChargesLampiran[]
}

model tbLocalChargesDetail {
  fdId             Int            @id @default(autoincrement())
  
  fdLocalChargesId Int
  localCharges     tbLocalCharges @relation(fields: [fdLocalChargesId], references: [fdId], onDelete: Cascade)
  
  fdNo             Int            @db.TinyInt
  fdNamaCustomer   String         @db.VarChar(150)
  fdMarking        String?        @db.VarChar(100)
  fdNoReceipt      String?        @db.VarChar(100)
  fdNoBilling      String?        @db.VarChar(100)
  fdKeterangan     String?        @db.VarChar(500)
  fdNoInputan      String?        @db.VarChar(100)
  fdMataUang       String?        @default("IDR") @db.VarChar(10)
  fdJumlah         Decimal?       @db.Decimal(18, 2)
}

model tbLocalChargesLampiran {
  fdId             Int            @id @default(autoincrement())
  
  fdLocalChargesId Int
  localCharges     tbLocalCharges @relation(fields: [fdLocalChargesId], references: [fdId], onDelete: Cascade)
  
  fdNamaFile       String         @db.VarChar(255)
  fdNamaFileSimpan String         @db.VarChar(255)
  fdMimeType       String         @db.VarChar(100)
  fdUkuranBytes    BigInt
  fdPath           String         @db.VarChar(500)
  
  fdUploadedBy     Int
  user             tbUsers        @relation(fields: [fdUploadedBy], references: [fdId], onUpdate: NoAction)
  
  fdUploadedAt     DateTime       @default(now())
  fdKeterangan     String?        @db.VarChar(255)
}

model VwtbEntryListCustomer {
  fdListCode    String               @id @db.Char(7)
  fdMarkingCode String               @db.Char(30)
  fdMarkingNo   String               @db.Char(50)
  fdTerima      String?              
  fdCustName    String?              @db.VarChar(150)
  reports       tbInspectionReport[]

  @@map("vwtbEntryListCustomer")
}

model tbInspectionReport {
  fdId             Int                          @id @default(autoincrement())
  fdReportNumber   String                       @unique @db.VarChar(30)
  fdReportDate     DateTime
  fdListCode       String                       @db.Char(7)
  fdMarkingCode    String                       @db.Char(30)
  fdMarkingNo      String                       @db.Char(50)
  fdNamaCustomer   String                       @db.VarChar(150)
  fdTerima         String?                      @db.VarChar(50)
  fdKeterangan     String                       @db.VarChar(Max)
  fdStatus         String                       @default("1") @db.VarChar(1)
  
  fdCreatedBy      Int
  user             tbUsers                      @relation(fields: [fdCreatedBy], references: [fdId], onUpdate: NoAction)
  
  fdCreatedAt      DateTime                     @default(now())
  fdUpdatedAt      DateTime                     @default(now()) @updatedAt
  fdDeletedAt      DateTime?

  entryList        VwtbEntryListCustomer?       @relation(fields: [fdListCode], references: [fdListCode])
  lampiran         tbInspectionReportLampiran[]

  @@map("tbInspectionReport")
}

model tbInspectionReportLampiran {
  fdId                 Int                @id @default(autoincrement())
  
  fdInspectionReportId Int
  report               tbInspectionReport @relation(fields: [fdInspectionReportId], references: [fdId], onDelete: Cascade)
  
  fdNamaFile           String             @db.VarChar(255)
  fdNamaFileSimpan     String             @db.VarChar(255)
  fdMimeType           String             @db.VarChar(100)
  fdUkuranBytes        BigInt
  fdPath               String             @db.VarChar(500)
  
  fdUploadedBy         Int
  user                 tbUsers            @relation(fields: [fdUploadedBy], references: [fdId], onUpdate: NoAction)
  
  fdUploadedAt         DateTime           @default(now())
  fdKeterangan         String?            @db.VarChar(255)

  @@map("tbInspectionReportLampiran")
}

// ============================================================
// PRICE LIST MODULE
// ============================================================

model tbPriceListUpload {
  fdId            Int      @id @default(autoincrement())
  fdFileName      String   @db.NVarChar(255)
  fdUploadedBy    Int?
  user            tbUsers? @relation(fields: [fdUploadedBy], references: [fdId], onUpdate: NoAction)
  fdUploadedAt    DateTime @default(now())
  fdPriceDate     DateTime?
  fdEffectiveDate DateTime
  fdStatus        String   @default("PARSED") @db.NVarChar(20)
  fdWarnings      String?  @db.NVarChar(Max)
  fdRawSnapshot   String?  @db.NVarChar(Max)

  items           tbPriceListItem[]
  branches        tbPriceListUploadBranch[]

  @@index([fdUploadedAt])
  @@index([fdPriceDate])
  @@index([fdEffectiveDate])
  @@map("tbPriceListUpload")
}

model tbPriceListItem {
  fdId          Int               @id @default(autoincrement())
  fdUploadId    Int
  upload        tbPriceListUpload @relation(fields: [fdUploadId], references: [fdId], onDelete: Cascade)

  fdSheetType   String   @db.NVarChar(20)
  fdMode        String   @db.NVarChar(20)
  fdBranch      String   @db.NVarChar(20)
  fdTransitTime String?  @db.NVarChar(50)
  fdCategory    String   @db.NVarChar(150)
  fdPrice       Decimal  @db.Decimal(14, 2)

  @@index([fdUploadId])
  @@index([fdSheetType, fdMode, fdBranch, fdCategory])
  @@map("tbPriceListItem")
}

model tbPriceListUploadBranch {
  fdId          Int               @id @default(autoincrement())
  fdUploadId    Int
  upload        tbPriceListUpload @relation(fields: [fdUploadId], references: [fdId], onDelete: Cascade)
  fdBranch      String            @db.NVarChar(20)
  fdMarkingCode String?           @db.NVarChar(30)

  @@unique([fdUploadId, fdBranch])
  @@index([fdBranch])
  @@index([fdMarkingCode])
  @@map("tbPriceListUploadBranch")
}
